<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_sale_task_link" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.sale.task.link</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_sale_orders_from_tasks"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-usd"
                        invisible="sale_order_count_from_tasks == 0">
                    <field name="sale_order_count_from_tasks" widget="statinfo" string="Ventas"/>
                </button>
            </div>
        </field>
    </record>
</odoo>