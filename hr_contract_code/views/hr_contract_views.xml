<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- View hr.contract form -->
    <record id="hr_contract_view_form_inherit_sequence" model="ir.ui.view">
        <field name="name">hr.contract.view.form.inherit.sequence</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]/h1" position="before">
                <h1 class="d-flex flex-row align-items-center">
                    <field name="code" class="text-truncate" readonly="1"/>
                </h1>
            </xpath>
        </field>
    </record>

</odoo>