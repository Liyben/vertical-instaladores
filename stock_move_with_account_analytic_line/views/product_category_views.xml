<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record model="ir.ui.view" id="view_category_property_form">
        <field name="name">product.category.stock.property.form.inherit</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="stock_account.view_category_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='account_stock_property']" position="attributes">
                <attribute name="invisible">property_valuation != 'real_time'</attribute>
            </xpath>
        </field>
    </record>
    
</odoo>