<odoo noupdate="1">
    <record model="ir.cron" forcecreate="True" id="check_version_installed_modules">
        <field name="name">Comprobar versión en repositorios de modulos instalados</field>
        <field name="model_id" ref="model_ir_module_module" />
        <field name="state">code</field>
        <field name="code">model.update_published_version()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
    </record>
</odoo>
