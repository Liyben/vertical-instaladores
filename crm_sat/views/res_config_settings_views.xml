<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.crm.sat</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="crm.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <app name="crm" position="inside">
                <block title="SAT" name="sat">
                    <setting string="Etapa ganada para oportunidad" help="" id="stage_opportunity">
                        <field name="stage_opportunity_id"/>
                    </setting>
                </block>
            </app>
        </field>
    </record>
</odoo>
