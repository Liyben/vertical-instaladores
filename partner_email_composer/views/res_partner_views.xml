<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_mail_composer" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.mail.composer</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Interceptamos el formulario modal incrustado en el campo O2M de los hijos -->
            <xpath expr="//field[@name='child_ids']/form//field[@name='email']" position="after">
                <field name="include_in_mail_composer" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>
</odoo>