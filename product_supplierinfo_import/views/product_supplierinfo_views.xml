<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- View product.supplierinfo form -->
    <record id="view_product_supplierinfo_form" model="ir.ui.view">
        <field name="name">view.product.supplierinfo.form</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='discount']" position="before">
                <field name="benefit" />
            </xpath>
        </field>
    </record>


    <!-- View product.supplierinfo tree -->
    <record id="view_product_supplierinfo_tree" model="ir.ui.view">
        <field name="name">view.product.supplierinfo.tree</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='discount']" position="before">
                <field name="benefit" />
            </xpath>
        </field>
    </record>

</odoo>