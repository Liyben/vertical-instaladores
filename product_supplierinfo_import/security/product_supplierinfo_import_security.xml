<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Security category definition -->
    <record id="category_product_supplierinfo_import" model="ir.module.category">
        <field name="name">Product Supplierinfo Import</field>
        <field name="description">Security category for Product Supplierinfo Import</field>
        <field name="sequence">1</field>
    </record>

    <!-- Group for regular users -->
    <record id="group_product_supplierinfo_import_user" model="res.groups">
        <field name="name">Import User</field>
        <field name="category_id" ref="category_product_supplierinfo_import"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Group for administrators -->
    <record id="group_product_supplierinfo_import_manager" model="res.groups">
        <field name="name">Import Manager</field>
        <field name="category_id" ref="category_product_supplierinfo_import"/>
        <field name="implied_ids" eval="[(4, ref('group_product_supplierinfo_import_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>