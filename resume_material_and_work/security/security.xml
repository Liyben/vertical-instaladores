<odoo>
<data noupdate="1">
    <record id="group_sales_resume" model="res.groups">
        <field name="name">Mostar pestaña resumen de materiales y mano de obra en partidas.</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

    <!-- Rules -->
    <record model="ir.rule" id="record_sale_order_task_material_shared_company_rule">
        <field name="name">Sale Order Task Material: multi-company</field>
        <field name="model_id" ref="model_sale_order_task_material"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
    </record>

    <record model="ir.rule" id="record_sale_order_task_work_shared_company_rule">
        <field name="name">Sale Order Task Work: multi-company</field>
        <field name="model_id" ref="model_sale_order_task_work"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
    </record>
</data>
</odoo>