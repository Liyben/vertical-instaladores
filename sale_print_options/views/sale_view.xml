<odoo>
    
    <record model="ir.ui.view" id="view_sale_order_print_options_form">
        <field name="name">sale.order.print.options.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Impresión" name="print_options">
                    <div class="oe_button_box" name="buttons_print">
                        <group>
                            <group>
                                <group>
                                    <field name="detailed_time" invisible="1" />
                                    <button
                                        name="print_detailed_time"
                                        type="object"
                                        class="oe_stat_button"
                                        icon="fa-print"
                                        groups="sale_print_options.group_sales_print_options"
                                    >
                                        <span
                                            class="text-success"
                                            invisible="not detailed_time"
                                        >Horas</span>
                                        <span
                                            class="text-danger"
                                            invisible="detailed_time"
                                        >Sin Horas</span>
                                    </button>
                                </group>
                                <group>
                                    <field name="detailed_subtotal_price_time" invisible="1" />
                                    <button
                                        name="print_detailed_subtotal_price_time"
                                        type="object"
                                        invisible="not detailed_time"
                                        class="oe_stat_button"
                                        icon="fa-print"
                                        groups="sale_print_options.group_sales_print_options"
                                    >
                                        <span
                                            class="text-success"
                                            invisible="not detailed_subtotal_price_time"
                                        >Subtotal Hr.</span>
                                        <span
                                            class="text-danger"
                                            invisible="detailed_subtotal_price_time"
                                        >Sin Subtotal Hr.</span>
                                    </button>

                                    <field name="detailed_price_time" invisible="1" />
                                    <button
                                        name="print_detailed_price_time"
                                        type="object"
                                        invisible="not detailed_time"
                                        class="oe_stat_button"
                                        icon="fa-print"
                                        groups="sale_print_options.group_sales_print_options"
                                    >
                                        <span
                                            class="text-success"
                                            invisible="not detailed_price_time"
                                        >Precio Hr.</span>
                                        <span
                                            class="text-danger"
                                            invisible="detailed_price_time"
                                        >Sin Precio Hr.</span>
                                    </button>
                                </group>
                            </group>
                            <group>
                                <group>
                                    <field name="detailed_materials" invisible="1" />
                                    <button
                                        name="print_detailed_materials"
                                        type="object"
                                        class="oe_stat_button"
                                        icon="fa-print"
                                        groups="sale_print_options.group_sales_print_options"
                                    >
                                        <span
                                            class="text-success"
                                            invisible="not detailed_materials"
                                        >Materiales</span>
                                        <span
                                            class="text-danger"
                                            invisible="detailed_materials"
                                        >Sin Materiales</span>
                                    </button>
                                </group>
                                <group>
                                    <field name="detailed_subtotal_price_materials" invisible="1" />
                                    <button
                                        name="print_detailed_subtotal_price_materials"
                                        type="object"
                                        invisible="not detailed_materials"
                                        class="oe_stat_button"
                                        icon="fa-print"
                                        groups="sale_print_options.group_sales_print_options"
                                    >
                                        <span
                                            class="text-success"
                                            invisible="not detailed_subtotal_price_materials"
                                        >Subtotal Mat.</span>
                                        <span
                                            class="text-danger"
                                            invisible="detailed_subtotal_price_materials"
                                        >Sin Subtotal Mat.</span>
                                    </button>

                                    <field name="detailed_price_materials" invisible="1" />
                                    <button
                                        name="print_detailed_price_materials"
                                        type="object"
                                        invisible="not detailed_materials"
                                        class="oe_stat_button"
                                        icon="fa-print"
                                        groups="sale_print_options.group_sales_print_options"
                                    >
                                        <span
                                            class="text-success"
                                            invisible="not detailed_price_materials"
                                        >Precio Mat.</span>
                                        <span
                                            class="text-danger"
                                            invisible="detailed_price_materials"
                                        >Sin Precio Mat.</span>
                                    </button>
                                </group>
                            </group>
                        </group>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

</odoo>