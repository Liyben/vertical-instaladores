<odoo>

    <record model="ir.ui.view" id="report_concatenate_sale_order_line_form_view">
        <field name="name">report.concatenate.sale.order.line.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-block" invisible="type == 'service'">
                    <field name="concatenate_description"/>
                    <label for="concatenate_description"/>
                </span>
            </xpath>
        </field>
    </record>
    
</odoo>