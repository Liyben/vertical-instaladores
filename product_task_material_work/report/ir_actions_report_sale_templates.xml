<odoo>

        <!-- Plantilla Sale Service -->
    
    <template id="report_saleorder_document" inherit_id="sale.report_saleorder_document">

        <!-- Tamaño de letra del report 
        <xpath expr="//div[@class='page']" position="attributes">
          <attribute name="style">font-size: 11px !important;</attribute>
        </xpath> -->

        <!-- Impresión de albarán de venta-->
        <xpath expr="//h2[@class='mt-4']" position="replace">
            <h2 class="mt-4">
                <span t-if="env.context.get('proforma', False) or is_pro_forma">Factura Proforma # </span>
                <span t-elif="is_delivery_note">Albarán de venta # </span>
                <span t-elif="doc.state in ['draft','sent']">Presupuesto # </span>
                <span t-else="">Pedido # </span>
                <span t-field="doc.name">SO0000</span>
            </h2>
        </xpath>
        <!--
        <xpath expr="//p[@t-if='doc.payment_term_id.note']" position="replace">

        </xpath>

        <xpath expr="//div[@name='so_total_summary']" position="after">
            <p t-if="doc.payment_term_id.note">
                <span t-field="doc.payment_term_id.note"/>
            </p>
        </xpath>
        -->
        <xpath expr="//div[@id='informations']" position="replace">
            <div class="row mt-4 mb-2" id="informations">
                <div t-if="doc.date_order" class="col-auto col-3 mw-100 mb-2" name="informations_date">
                    <strong t-if="doc.state in ['draft', 'sent']">Fecha del presupuesto:</strong>
                    <strong t-else="">Fecha del pedido:</strong><br/>
                    <span class="m-0" t-field="doc.date_order" t-options='{"widget": "date"}'>2023-12-31</span>
                </div>
                <div t-if="doc.user_id.name" class="col-auto col-3 mw-100 mb-2">
                    <strong>Comercial:</strong>
                    <span class="m-0" t-field="doc.user_id">Mitchell Admin</span>
                </div>
                <div t-if="doc.ref" class="col-auto col-3 mw-100 mb-2">
                    <strong>Nº cliente:</strong>
                    <p class="m-0" t-field="doc.ref"/>
                </div>
                <div t-if="doc.client_order_ref" class="col-auto col-3 mw-100 mb-2">
                    <strong>Ref. del cliente:</strong>
                    <p class="m-0" t-field="doc.client_order_ref"/>
                </div>
                <div t-if="doc.validity_date and doc.state in ['draft', 'sent']"
                    class="col-auto col-3 mw-100 mb-2"
                    name="expiration_date">
                    <strong>Fecha de caducidad:</strong><br/>
                    <span class="m-0" t-field="doc.validity_date">2023-12-31</span>
                </div>
            </div>
        </xpath>

        <xpath expr="//table[@class='table table-sm o_main_table table-borderless mt-4']" position="before">
            <t t-if="not display_discount">
                <t t-foreach="lines_to_report" t-as="line">
                    <t t-set="display_discount" t-value="any([work.discount for work in line.task_works_ids])"/>
                    <t t-if="not display_discount">
                        <t t-set="display_discount" t-value="any([material.discount for material in line.task_materials_ids])"/>
                    </t>
                </t>
            </t>
        </xpath>
        
        <xpath expr="//table[@class='table table-sm o_main_table table-borderless mt-4']" position="replace">
            <table class="table table-sm o_main_table">
                <thead style="display: table-row-group">
                    <tr>
                        <th name="th_description" >Descripción</th>
                        <th name="th_quantity" class="text-end">Cantidad</th>
                        <th t-if="not (is_without_valuing and is_delivery_note)" name="th_priceunit" class="text-end">P. Und</th>
                        <th t-if="not (is_without_valuing and is_delivery_note) and display_discount" name="th_discount" class="text-end">Desc.%</th>
                        <th t-if="not (is_without_valuing and is_delivery_note)" name="th_subtotal" class="text-end">
                            <span>Total</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="sale_tbody">

                    <t t-set="current_subtotal" t-value="0"/>

                    <t t-foreach="lines_to_report" t-as="line">

                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" />

                        <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else 'product-row'">
                            <t t-if="not line.display_type">
                                <td name="td_name"><span t-field="line.name">Bacon Burger</span></td>
                                <!-- IMPRESION DE SOLO TEXTO CUANDO LA CANTIDAD ES 0 -->
                                <td name="td_quantity" class="text-end">
                                    <t t-if="not line.product_uom_qty == 0">
                                        <span t-field="line.product_uom_qty">3</span>
                                        <span t-field="line.product_uom">units</span>
                                        <span t-if="line.product_packaging_id">
                                            (<span t-field="line.product_packaging_qty" t-options='{"widget": "integer"}'/> <span t-field="line.product_packaging_id"/>)
                                        </span>
                                    </t>
                                </td>
                                <td t-if="not (is_without_valuing and is_delivery_note)" name="td_priceunit" class="text-end">
                                    <t t-if="not line.product_uom_qty == 0">
                                        <span t-field="line.price_unit">3</span>
                                    </t>
                                </td>
                                <td t-if="not (is_without_valuing and is_delivery_note) and display_discount" class="text-end">
                                    <t t-if="not line.product_uom_qty == 0">
                                        <span t-field="line.discount">-</span>
                                    </t>
                                </td>
                                <td t-if="not line.is_downpayment and not (is_without_valuing and is_delivery_note)" name="td_subtotal" class="text-end o_price_total">
                                    <t t-if="not line.product_uom_qty == 0">
                                        <span t-field="line.price_subtotal">27.00</span>
                                    </t>
                                </td>
                            </t>
                            <t t-elif="line.display_type == 'line_section'">
                                <td name="td_section_line" colspan="99">
                                    <span t-field="line.name">A section title</span>
                                </td>
                                <t t-set="current_section" t-value="line"/>
                                <t t-set="current_subtotal" t-value="0"/>
                            </t>
                            <t t-elif="line.display_type == 'line_note'">
                                <td name="td_note_line" colspan="99">
                                    <span t-field="line.name">A note, whose content usually applies to the section or product above.</span>
                                </td>
                            </t>
                        </tr>

                        <t t-if="current_section and (line_last or lines_to_report[line_index+1].display_type == 'line_section') and not line.is_downpayment">
                            <tr t-if="not (is_without_valuing and is_delivery_note)" class="is-subtotal text-end">
                                <td name="td_section_subtotal" colspan="99">
                                    <strong class="mr16">Subtotal</strong>
                                    <span
                                        t-out="current_subtotal"
                                        t-options='{"widget": "monetary", "display_currency": doc.currency_id}'
                                    >31.05</span>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>      
            </table>
        </xpath>

        <xpath expr="//span[@t-field='line.name']/../.." position="inside">

                <t t-if="line.task_works_ids and line.detailed_time">
                    <t t-set="uom_hour" t-value="line.env.ref('uom.product_uom_hour')"/>
                    <t t-raw="'&lt;/tr&gt;&lt;tr class=\'works_title\'&gt;'"/>
                        <td class="works_lbl">Total Trabajos Und.</td>
                        <td class="works_total_hours">
                            <t t-if="line.detailed_time">
                            </t>
                        </td>
                        <td t-if="not (is_without_valuing and is_delivery_note)" class="works_hours_price">                            
                        </td>
                        <td t-if="not (is_without_valuing and is_delivery_note) and display_discount" class="text-end"></td>
                        <td t-if="not (is_without_valuing and is_delivery_note)" class="works_total_amount text-end o_price_total">
                            <t t-if="line.detailed_subtotal_price_time">
                                <span t-esc="'{0:,.2f}'.format(line.total_sp_work).replace('.', ',')"/> <span t-field="doc.pricelist_id.currency_id.symbol"/>
                            </t>
                        </td>
                    <t t-foreach="line.task_works_ids" t-as="work">
                        <t t-raw="'&lt;/tr&gt;&lt;tr class=\'works_line\'&gt;'"/>
                        <td class="works_line_name">
                            <t t-if="line.detailed_time">
                                <span t-field="work.name"/>
                            </t>
                        </td>
                        <td class="works_line_hours">
                            <t t-if="line.detailed_price_time">
                                <span t-esc="'{0:,.2f}'.format(work.hours).replace('.', ',')"/>
                                <span groups="uom.group_uom" t-field="uom_hour.name"/>
                            </t>
                        </td>
                        <!-- REPORT DESGLOSE HORAS -->
                        <td t-if="not (is_without_valuing and is_delivery_note)" class="materials_line_price">
                            <t t-if="line.detailed_price_time">
                                <span t-field="work.sale_price_unit" t-field-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: &quot;doc.pricelist_id.currency_id&quot;}"/>
                            </t>
                        </td>
                        <td class="materials_line_price" t-if="not (is_without_valuing and is_delivery_note) and display_discount">
                            <t t-if="line.detailed_price_time">
                                <span t-esc="'{0:,.2f}'.format(work.discount).replace('.', ',')"/>
                            </t>
                        </td>
                        <td t-if="not (is_without_valuing and is_delivery_note)" class="materials_line_price text-end o_price_total">
                            <t t-if="line.detailed_price_time">
                                <span t-esc="'{0:,.2f}'.format(work.sale_price_unit * work.hours * (1 - (work.discount/100))).replace('.', ',')"/> <span t-field="doc.pricelist_id.currency_id.symbol"/>
                            </t>
                        </td>
                    </t>
                </t>
                <t t-if="line.task_materials_ids and line.detailed_materials">
                    <t t-raw="'&lt;/tr&gt;&lt;tr class=\'materials_title\'&gt;'"/>
                        <td class="materials_lbl">Total Materiales Und.</td>
                        <td></td>
                        <td t-if="not (is_without_valuing and is_delivery_note)"></td>
                        <td t-if="not (is_without_valuing and is_delivery_note) and display_discount" class="text-end"></td>
                        <td t-if="not (is_without_valuing and is_delivery_note)" class="materials_total_amount text-end o_price_total">
                            <t t-if="line.detailed_subtotal_price_materials">
                                <span t-esc="'{0:,.2f}'.format(line.total_sp_material).replace('.', ',')"/> <span t-field="doc.pricelist_id.currency_id.symbol"/>
                            </t>
                        </td>
                    <t t-foreach="line.task_materials_ids" t-as="material">
                        <t t-raw="'&lt;/tr&gt;&lt;tr class=\'materials_line\'&gt;'"/>
                        <td class="materials_line_name">
                            <t t-if="material.name"><span t-field="material.name"/></t>
                            <t t-if="not material.name"><span t-field="material.material_id.name"/></t>
                        </td>
                        <td class="materials_line_qty">
                            <span t-esc="'{0:,.2f}'.format(material.quantity).replace('.', ',')"/>
                            <span groups="uom.group_uom" t-field="material.material_id.uom_id.name"/>
                        </td>
                        <td t-if="not (is_without_valuing and is_delivery_note)" class="materials_line_price">
                            <t t-if="line.detailed_price_materials">
                                <span t-field="material.sale_price_unit" t-field-options='{"widget": "monetary", "display_currency": "doc.pricelist_id.currency_id"}'/>
                            </t>
                        </td>
                        <td class="materials_line_qty" t-if="not (is_without_valuing and is_delivery_note) and display_discount">
                            <t t-if="line.detailed_price_materials">
                                <span t-esc="'{0:,.2f}'.format(material.discount).replace('.', ',')"/>
                            </t>
                        </td>
                        <td t-if="not (is_without_valuing and is_delivery_note)" class="materials_line_price text-end o_price_total">
                            <t t-if="line.detailed_price_materials">
                                <span t-esc="'{0:,.2f}'.format(material.sale_price_unit * material.quantity * (1 - (material.discount/100))).replace('.', ',')"/> <span t-field="doc.pricelist_id.currency_id.symbol"/>
                            </t>
                        </td>
                    </t>
                </t>

        </xpath>

        <xpath expr="//div[@name='so_total_summary']" position="attributes">
            <attribute name="t-if">not (is_without_valuing and is_delivery_note)</attribute>
        </xpath>
    </template>

    <template id="report_saleorder_sales_delivery_note">
        <t t-call="web.html_container">
            <t t-set="is_delivery_note" t-value="True"/>
            <t t-set="is_without_valuing" t-value="True"/>
            <t t-foreach="docs" t-as="doc">
                <t t-call="sale.report_saleorder_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

</odoo>
