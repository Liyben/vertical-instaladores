<odoo>
    <!-- Both -->
    <record id="crm_lead_view_form" model="ir.ui.view">
        <field name="name">CRM - Leads with task</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">
            <!-- New fields -->
            <page name="extra" position="after">
                <page string="Tareas" name="tasks">
                    <field name="task_ids" readonly="1" groups="hr_timesheet.group_hr_timesheet_user"/>
                </page>
            </page>
        </field>
    </record>

    <record id="crm_lead_view_form_analytic_plan" model="ir.ui.view">
        <field name="name">CRM - Leads with analytic plan</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm_timesheet.crm_lead_view_form" />
        <field name="arch" type="xml">
            <!-- New fields -->
            <field name="project_id" position="before">
                <field
                    name="plan_id"
                    groups="analytic.group_analytic_accounting"
                />
            </field>
        </field>
    </record>

    
</odoo>