<odoo>
    <!-- Both -->
    <record id="crm_lead_view_form" model="ir.ui.view">
        <field name="name">CRM - Leads with task</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">
            <!-- New fields -->
            <div name="button_box" position="inside">
                <button class="oe_stat_button" 
                        type="action" 
                        name="%(task_action_crm_lead)d" 
                        icon="fa-newspaper" 
                        groups="product_task_material_work.group_view_pt_stats">
                    
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="task_number"/>
                        </span>
                        <span class="o_stat_text">Ver PTs</span>
                    </div>

                </button>
            </div>

            <page name="extra" position="after">
                <page string="Tareas" name="tasks">
                    <field name="task_ids" readonly="1" groups="hr_timesheet.group_hr_timesheet_user"/>
                </page>
            </page>
        </field>
    </record>
    
</odoo>