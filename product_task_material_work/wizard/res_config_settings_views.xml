<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale.management</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="pricing_setting_container" position="inside">
                <setting id="percent_waste_product" title="Añade un porcentaje de desperdicio al producto partida para obtener el coste total." help="Mostrar % desperdicio en productos partida y linea de pedido.">
                    <field name="group_percent_waste"/>
                </setting>
            </block>
        </field>
    </record>

</odoo>
