<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="crm_type_sat_form_view_res_partner" model="ir.ui.view">
            <field name="name">crm.type.sat.form.view.res.partner</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field eval="18" name="priority"/>
            <field name="groups_id" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="arch" type="xml">
                <data>
                    <div name="button_box" position="inside">
                        <button class="oe_stat_button o_res_partner_tip_opp" type="object"
                            name="action_view_sat"
                            icon="fa-eye-slash"
                            groups="sales_team.group_sale_salesman"
                            context="{'default_partner_id': id, 'default_type':'sat'}">
                            <field string="SAT" name="sat_count" widget="statinfo"/>
                        </button>
                    </div>
                </data>
            </field>
        </record>

</odoo>