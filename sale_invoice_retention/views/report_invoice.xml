<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="document_tax_totals_template" inherit_id="account.document_tax_totals_template">
            <xpath expr="//tr[@class='border-black o_total']" position="after">
                <t t-if="print_retention">
                    <t t-if="o.percent_retention > 0.0 and o.move_type in ('out_invoice', 'out_refund') and o.payment_state != 'paid'">
                        <tr>
                            <td>
                                Retención <span t-field="o.percent_retention"/>% de <span t-field="o.amount_untaxed"/>
                            </td>
                            <td class="text-end o_price_total">
                                <span class="text-nowrap" t-field="o.amount_retention"/>
                            </td>
                        </tr>
                        <tr class="border-black o_total">
                            <td><strong>Total a pagar</strong></td>
                            <td  class="text-end">
                                <span t-field="o.amount_to_pay"/>
                            </td>
                        </tr>
                    </t>
                </t>
            </xpath>
        </template>

        <template id="report_invoice_document" inherit_id="account.report_invoice_document">
            <xpath expr="//div[@id='informations']" position="before">
                <t t-set="print_retention" t-value="True"/>
            </xpath>
        </template>
    </data>
</odoo>