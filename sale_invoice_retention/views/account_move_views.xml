<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- View account.move form -->
    <record id="view_account_move_form" model="ir.ui.view">
        <field name="name">view.account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <field name="percent_retention" readonly="state != 'draft'" invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
            <xpath expr="//field[@name='tax_totals']" position="after">
                <label for="amount_retention" groups="base.group_user" invisible="percent_retention == 0.0 or move_type not in ('out_invoice', 'out_refund')"/>
                <div class="text-nowrap" groups="base.group_user" invisible="percent_retention == 0.0 or move_type not in ('out_invoice', 'out_refund')">
                    <field name="amount_untaxed" invisible="1"/>
                    <field name="amount_retention" class="oe_inline"/>
                </div>
                <label for="amount_to_pay" groups="base.group_user" invisible="percent_retention == 0.0 or move_type not in ('out_invoice', 'out_refund')"/>
                <div class="text-nowrap" groups="base.group_user" invisible="percent_retention == 0.0 or move_type not in ('out_invoice', 'out_refund')">
                    <field name="amount_total" invisible="1"/>
                    <field name="amount_to_pay" class="oe_inline"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>