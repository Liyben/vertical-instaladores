<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- View sale.order form -->
    <record id="view_sale_order_form" model="ir.ui.view">
        <field name="name">view.sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="percent_retention" readonly="state in ['cancel', 'sale']"/>
            </xpath>
            <xpath expr="//field[@name='tax_totals']" position="after">
                <label for="amount_retention" groups="base.group_user" invisible="percent_retention == 0.0"/>
                <div class="text-nowrap" groups="base.group_user" invisible="percent_retention == 0.0">
                    <field name="amount_untaxed" invisible="1"/>
                    <field name="amount_retention" class="oe_inline"/>
                </div>
                <label for="amount_to_pay" groups="base.group_user" invisible="percent_retention == 0.0"/>
                <div class="text-nowrap" groups="base.group_user" invisible="percent_retention == 0.0">
                    <field name="amount_total" invisible="1"/>
                    <field name="amount_to_pay" class="oe_inline"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>