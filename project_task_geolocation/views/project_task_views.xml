<odoo>
    <record id="view_task_form2_inherit_geo" model="ir.ui.view">
        <field name="name">project.task.form.geo</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project_timesheet_time_control.view_task_form2_inherited"/>
        <field name="arch" type="xml">
            
            <xpath expr="//button[@name='button_start_work']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//button[@name='button_end_work']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            
            <xpath expr="///button[@name='action_open_parent_task']" position="before">
                <field name="show_time_control" widget="geo_control_buttons" nolabel="1"/>
            </xpath>

            <!-- Sub-tree view for timesheet_ids -->
            <xpath expr="//field[@name='timesheet_ids']/tree//field[@name='date']" position="attributes">
                <attribute name="column_invisible">0</attribute>
            </xpath>
            <xpath expr="//field[@name='timesheet_ids']/tree//field[@name='date_time']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='timesheet_ids']/tree//field[@name='name']" position="after">
                <field name="geo_start_lat" column_invisible="1"/>
                <field name="geo_stop_lat" column_invisible="1"/>
                <field name="date_time" string="Inicio" required="1"/>
                <button name="action_view_geo_start"
                        type="object"
                        tabindex="-1"
                        class="oe_stat_button"
                        icon="fa-map-marker"
                        title="Ver ubicación inicio"
                        invisible="not geo_start_lat"/>
                <field name="date_time_end" string="Fin" required="0"/>
                <button name="action_view_geo_stop"
                        type="object"
                        tabindex="-1"
                        class="oe_stat_button"
                        icon="fa-flag-checkered"
                        title="Ver ubicación fin"
                        invisible="not geo_stop_lat"/>
            </xpath>
            <xpath expr="//field[@name='timesheet_ids']/tree//button[@name='button_resume_work']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='timesheet_ids']/tree//button[@name='button_end_work']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Sub-kanban view for timesheet_ids -->
            <xpath expr="//field[@name='timesheet_ids']/kanban//*[@t-esc='record.date.value']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
            <xpath expr="//field[@name='timesheet_ids']/kanban//field[@name='date_time']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='timesheet_ids']/kanban//div[hasclass('row')][1]" position="after">
                <div class="row">
                    <div class="col-6 float-end text-end">
                        <field name="geo_start_lat" invisible="1"/>
                        <strong><span>Inicio: </span><field name="date_time"/></strong>
                        <button name="action_view_geo_start"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-map-marker"
                            title="Ver ubicación inicio"
                            invisible="not geo_start_lat"/>
                    </div>
                    <div class="col-6 float-end text-end">
                        <field name="geo_stop_lat" invisible="1"/>
                        <strong><span>Fin: </span><field name="date_time_end"/></strong>
                        <button name="action_view_geo_stop"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-flag-checkered"
                            title="Ver ubicación fin"
                            invisible="not geo_stop_lat"/>
                    </div>
                </div>
            </xpath>
            <xpath expr="//field[@name='timesheet_ids']/kanban//templates//a[@name='button_resume_work']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='timesheet_ids']/kanban//templates//a[@name='button_end_work']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            
            <!-- Sub-form view for timesheet_ids -->
            <xpath expr="//field[@name='timesheet_ids']/form//field[@name='date']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
            <xpath expr="//field[@name='timesheet_ids']/form//field[@name='date_time']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='timesheet_ids']/form//field[@name='name']" position="after">
                <label for="date_time" string="Geolocalización"/>                
                <div class="o_row d-flex align-items-center">
                    <field name="geo_start_lat" invisible="1"/>
                    <field name="date_time" class="me-1" required="1"/>
                    <button name="action_view_geo_start"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-map-marker"
                        title="Ver ubicación inicio"
                        invisible="not geo_start_lat"/>
                    
                    <span class="text-muted mx-2" invisible="not date_time_end">|</span>

                    <field name="geo_stop_lat" invisible="1"/>
                    <field name="date_time_end" class="me-1" required="0"/>
                    <button name="action_view_geo_stop"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-flag-checkered"
                        title="Ver ubicación fin"
                        invisible="not geo_stop_lat"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='timesheet_ids']/form//button[@name='button_resume_work']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='timesheet_ids']/form//button[@name='button_end_work']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>

    <record id="view_task_kanban_inherit_geo" model="ir.ui.view">
        <field name="name">project.task.kanban.geo</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project_timesheet_time_control.view_task_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//a[@name='button_resume_work']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//a[@name='button_end_work']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_task_tree_inherit_geo" model="ir.ui.view">
        <field name="name">project.task.tree.geo</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project_timesheet_time_control.view_task_tree2_inherited"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_resume_work']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='button_end_work']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>