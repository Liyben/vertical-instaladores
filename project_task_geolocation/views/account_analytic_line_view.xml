<odoo>
    <!-- Inherit Tree Views -->
    <record id="view_account_analytic_line_tree_inherit_geo" model="ir.ui.view">
        <field name="name">account.analytic.line.tree.geo</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="project_timesheet_time_control.account_analytic_line_tree"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='date']" position="attributes">
                <attribute name="column_invisible">0</attribute>
            </xpath>
            <xpath expr="//field[@name='date_time']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='date_time_end']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="geo_start_lat" column_invisible="1"/>
                <field name="geo_stop_lat" column_invisible="1"/>
                <field name="date_time" required="1"/>
                <button name="action_view_geo_start"
                    type="object"
                    tabindex="-1"
                    class="oe_stat_button"
                    icon="fa-map-marker"
                    title="Ver ubicación inicio"
                    invisible="not geo_start_lat"/>
                <field name="date_time_end" optional="show"/>
                <button name="action_view_geo_stop"
                    type="object"
                    tabindex="-1"
                    class="oe_stat_button"
                    icon="fa-flag-checkered"
                    title="Ver ubicación fin"
                    invisible="not geo_stop_lat"/>
            </xpath>
            <xpath expr="//button[@name='button_resume_work']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='button_end_work']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            
        </field>
    </record>

    <!-- Inherit Form Views -->
    <record id="view_account_analytic_line_form_inherit_geo" model="ir.ui.view">
        <field name="name">account.analytic.line.form.geo</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//group" position="after">
                <group string="Geolocalización">
                    <group>
                        <field name="geo_start_lat"/>
                        <field name="geo_start_lng"/>
                    </group>
                    <group>
                        <field name="geo_stop_lat"/>
                        <field name="geo_stop_lng"/>
                    </group>
                </group>
            </xpath>
            
        </field>
    </record>

    <record id="view_hr_timesheet_line_form_form_inherit_geo" model="ir.ui.view">
        <field name="name">account.analytic.line.hr.timesheet.line.form.geo</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="project_timesheet_time_control.hr_timesheet_line_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_geo_start"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-map-marker"
                        invisible="not geo_start_lat">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Inicio</span>
                        <span class="o_stat_value">Mapa</span>
                    </div>
                </button>

                <button name="action_view_geo_stop"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-flag-checkered"
                        invisible="not geo_stop_lat">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Fin</span>
                        <span class="o_stat_value">Mapa</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//button[@name='button_resume_work']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='button_end_work']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>

    <record id="view_kanban_account_analytic_line_inherit_geo" model="ir.ui.view">
        <field name="name">account.analytic.line.kanban.geo</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="project_timesheet_time_control.view_kanban_account_analytic_line"/>
        <field name="arch" type="xml">
            
            <xpath expr="//a[@name='button_resume_work']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//a[@name='button_end_work']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>

</odoo>