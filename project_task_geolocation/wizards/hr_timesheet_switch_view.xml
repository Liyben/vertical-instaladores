<odoo>
    <record id="hr_timesheet_switch_form_geo" model="ir.ui.view">
        <field name="name">hr.timesheet.switch.form.geo</field>
        <field name="model">hr.timesheet.switch</field>
        <field name="inherit_id" ref="project_timesheet_time_control.hr_timesheet_switch_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='name']" position="after">
                <field name="geo_lat" invisible="1"/>
                <field name="geo_lng" invisible="1"/>
            </xpath>

            <xpath expr="//footer/button[@name='action_switch']" position="replace">
                <widget name="geo_switch_button" nolabel="1"/>
            </xpath>

        </field>
    </record>
</odoo>