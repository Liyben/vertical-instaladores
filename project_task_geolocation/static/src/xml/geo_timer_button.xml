<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="project_task_geolocation.GeoTimerButton">
        <div class="d-flex gap-1" t-on-click.stop.prevent="">
            <button t-if="props.record.data.date_time_end" 
                    class="btn btn-primary btn-sm" 
                    t-on-click="() => this.onGeoClick('start')">
                <i class="fa fa-play"/>
            </button>
            
            <button t-if="!props.record.data.date_time_end" 
                    class="btn btn-danger btn-sm" 
                    t-on-click="() => this.onGeoClick('stop')">
                <i class="fa fa-stop"/>
            </button>
        </div>
    </t>
</templates>