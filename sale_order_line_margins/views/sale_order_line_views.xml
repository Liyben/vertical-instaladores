<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- View sale.order.line form -->
    <record id="view_sale_order_line_form" model="ir.ui.view">
        <field name="name">view.sale.order.line.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_margin.sale_margin_sale_order_line"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='purchase_price']" position="after">
                <field name="margin_benefit" groups="base.group_user" class="oe_inline"/> %
            </xpath>
        </field>
    </record>

</odoo>